generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
}

enum ConnectionStatus {
  online
  offline
}

model User {
  id                   BigInt           @id @default(autoincrement())
  username             String           @unique
  passwordHash         String           @map("password_hash")
  role                 Role
  isActive             Boolean          @default(true) @map("is_active")
  failedLoginAttempts  Int              @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?        @map("locked_until")
  twofaEnabled         Boolean          @default(false) @map("twofa_enabled")
  twofaSecret          String?          @map("twofa_secret")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  refreshSessions      RefreshSession[]
  auditLogs            AuditLog[]

  @@map("users")
}

model RefreshSession {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedById      BigInt?  @map("replaced_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession? @relation("SessionReplacements", fields: [replacedById], references: [id])
  replacements      RefreshSession[] @relation("SessionReplacements")

  @@index([userId])
  @@map("refresh_sessions")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  status     String? @map("status")
  requestId  String? @map("request_id")
  ip        String?
  userAgent String? @map("user_agent")
  meta      Json?
  before    Json?
  after     Json?
  diff      Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetType, targetId])
  @@index([requestId])
  @@map("audit_logs")
}

model CustomerStatus {
  id        BigInt            @id @default(autoincrement())
  username  String            @unique
  status    ConnectionStatus
  activeIp  String?           @map("active_ip")
  uptime    String?
  profile   String?
  comment   String?
  lastSeen  DateTime?         @map("last_seen")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([lastSeen])
  @@index([profile])
  @@index([comment])
  @@map("customer_status")
}

model SyncState {
  id            String   @id
  lastRunAt     DateTime? @map("last_run_at")
  lastSuccessAt DateTime? @map("last_success_at")
  lastError     String?  @map("last_error")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

model CustomerStatusEvent {
  id        BigInt            @id @default(autoincrement())
  username  String
  status    ConnectionStatus
  activeIp  String?           @map("active_ip")
  profile   String?
  comment   String?
  eventAt   DateTime          @default(now()) @map("event_at")

  @@index([username])
  @@index([eventAt])
  @@map("customer_status_events")
}

model ChangeRequest {
  id          String   @id @default(uuid())
  type        String
  payload     Json
  status      String
  error       String?  @map("error")
  createdById BigInt?  @map("created_by_id")
  confirmedById BigInt? @map("confirmed_by_id")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")
  executedAt  DateTime? @map("executed_at")

  createdBy   User?    @relation("ChangeRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?    @relation("ChangeRequestConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  rollbackSnapshots RollbackSnapshot[]

  @@index([status])
  @@map("change_requests")
}

model RollbackSnapshot {
  id             BigInt   @id @default(autoincrement())
  changeRequestId String  @map("change_request_id")
  snapshot       Json
  createdAt      DateTime @default(now()) @map("created_at")

  changeRequest  ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@map("rollback_snapshots")
}
