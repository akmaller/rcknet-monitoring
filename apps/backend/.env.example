NODE_ENV=development
PORT=4000
TRUST_PROXY=1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rcknet?schema=public
DB_POOL_MAX=10

LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=10000

SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../../frontend/dist

CORS_ORIGINS=http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token

SESSION_NAME=rcknet.sid
SESSION_SECRET=change_me_session_secret
SESSION_TTL_MINUTES=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/

CSRF_COOKIE_NAME=_csrf
CSRF_HEADER_NAME=X-CSRF-Token

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WRITE_MAX=30
SLOWDOWN_WINDOW_MS=60000
SLOWDOWN_DELAY_AFTER=50
SLOWDOWN_DELAY_MS=500

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change_me_admin_password
ADMIN_SEED_ROLE=admin

MT_HOST=10.200.200.1
MT_PORT=8728
MT_USER=admin
MT_PASS=changeme
MT_TIMEOUT_MS=5000
MT_RETRY_COUNT=2
MT_RETRY_DELAY_MS=500
MT_FETCH_SECRETS=true

SYNC_CRON=*/30 * * * * *
SYNC_LOCK_ID=83017
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=90

QUEUE_ENABLED=true
QUEUE_POLL_MS=2000
QUEUE_LOCK_ID=99017
QUEUE_MAX_ATTEMPTS=3
